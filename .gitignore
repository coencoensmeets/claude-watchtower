__pycache__/
.claude/worktrees/

# What the panel writes into a session's own folder: a picture pasted into the
# composer, and a copy of a file dropped on it that carried no path of its own.
# Both are scratch for one message, swept after five days. Each folder now
# carries a `*` .gitignore of its own, so other repositories need nothing; these
# lines stay for folders made before that.
.claude/watchtower-images/
.claude/watchtower-files/

# Built frontend — regenerated from web/ by `python3 server.py`.
dist/
.dist-build/

# A virtualenv in the checkout — where the build looks for a Node binary from
# nodejs-wheel-binaries when the machine has none of its own.
.venv/
venv/
