[Unit]
Description=claude-watchtower — live panel for local Claude Code sessions
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# No --port and no --host: the panel serves on the port it picked for this
# install and keeps in ~/.config/claude-watchtower/listen.json, and on every
# interface, so a phone on the same network can open it with the key it prints —
# see "From your phone" in the README. Add --local to keep it to this machine.
ExecStart=/usr/bin/python3 %h/Workspace/Projects/claude-watchtower/server.py
Restart=on-failure
RestartSec=3
# xdotool needs the X display to raise windows.
Environment=DISPLAY=:0

[Install]
WantedBy=graphical-session.target
